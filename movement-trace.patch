+#ifdef DEBUG_ENABLED
+void CharacterBody3D::set_movement_trace_enabled(bool p_enabled) {
+	movement_trace_enabled = p_enabled;
+	if (!p_enabled) {
+		movement_trace_steps.clear();
+		movement_trace_truncated = false;
+	}
+}
+
+bool CharacterBody3D::is_movement_trace_enabled() const {
+	return movement_trace_enabled;
+}
+
+void CharacterBody3D::_finish_movement_trace_step(MovementTraceStep &r_step, const Vector3 &p_motion, const StringName &p_reason) {
+	if (movement_trace_steps.size() >= MOVEMENT_TRACE_LIMIT) {
+		movement_trace_truncated = true;
+		return;
+	}
+	r_step.motion_after = p_motion;
+	r_step.velocity_after = velocity;
+	r_step.origin_after = get_global_position();
+	r_step.exit_reason = p_reason;
+	movement_trace_steps.push_back(r_step);
+}
+
+Dictionary CharacterBody3D::get_movement_trace() const {
+	Dictionary trace;
+	trace["enabled"] = movement_trace_enabled;
+	trace["grounded"] = movement_trace_grounded;
+	trace["call"] = movement_trace_call;
+	trace["physics_frame"] = movement_trace_frame;
+	trace["truncated"] = movement_trace_truncated;
+	trace["start"] = movement_trace_start;
+	trace["end"] = movement_trace_end;
+	trace["velocity_end"] = movement_trace_velocity_end;
+	Array steps;
+	for (const MovementTraceStep &step : movement_trace_steps) {
+		Dictionary entry;
+		entry["iteration"] = step.iteration;
+		entry["origin"] = step.origin;
+		entry["origin_after"] = step.origin_after;
+		entry["requested_motion"] = step.requested_motion;
+		entry["velocity_before"] = step.velocity_before;
+		entry["travel"] = step.query_result.travel;
+		entry["remainder"] = step.query_result.remainder;
+		entry["query_collided"] = step.query_collided;
+		entry["floor"] = step.floor;
+		entry["wall"] = step.wall;
+		entry["ceiling"] = step.ceiling;
+		entry["motion_after"] = step.motion_after;
+		entry["velocity_after"] = step.velocity_after;
+		entry["exit_reason"] = step.exit_reason;
+		Array contacts;
+		for (int i = 0; i < step.query_result.collision_count; i++) {
+			const PhysicsServer3D::MotionCollision &collision = step.query_result.collisions[i];
+			Dictionary contact;
+			contact["position"] = collision.position;
+			contact["normal"] = collision.normal;
+			contact["depth"] = collision.depth;
+			const bool valid = !collision.normal.is_zero_approx() && !movement_trace_up.is_zero_approx();
+			contact["math_valid"] = valid;
+			if (valid) {
+				const Vector3 n = collision.normal.normalized();
+				const Vector3 up = movement_trace_up.normalized();
+				const real_t alignment = CLAMP(n.dot(up), (real_t)-1.0, (real_t)1.0);
+				contact["angle_degrees"] = Math::rad_to_deg(Math::acos(alignment));
+				const Vector3 perpendicular = n * step.query_result.remainder.dot(n);
+				contact["normal_component"] = perpendicular;
+				contact["tangent_component"] = step.query_result.remainder - perpendicular;
+				// A stable basis for drawing a small contact-plane marker
+				const Vector3 reference = Math::abs(n.dot(Vector3(0, 1, 0))) < (real_t)0.9 ? Vector3(0, 1, 0) : Vector3(1, 0, 0);
+				const Vector3 tangent = n.cross(reference).normalized();
+				contact["plane_tangent"] = tangent;
+				contact["plane_bitangent"] = n.cross(tangent).normalized();
+			}
+			contacts.push_back(contact);
+		}
+		entry["contacts"] = contacts;
+		steps.push_back(entry);
+	}
+	trace["steps"] = steps;
+	return trace;
+}
